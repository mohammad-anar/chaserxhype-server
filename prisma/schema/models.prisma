model User {
    id                 String          @id @default(cuid())
    name               String
    email              String          @unique
    phone              String?         @unique
    password           String
    role               UserRole        @default(USER)
    status             UserStatus      @default(ACTIVE)
    profileImage       String?
    isVerified         Boolean         @default(false)
    isDeleted          Boolean         @default(false)
    otpCode            String?
    otpExpiresAt       DateTime?
    needPasswordChange Boolean         @default(true)
    isAvailable        Boolean         @default(true)
    skillLevel         Int             @default(5)
    activeOrderCount   Int             @default(0)
    station            String?
    loyaltyCode        String?         @unique
    giftCardBalance    Decimal         @default(0)
    createdAt          DateTime        @default(now())
    updatedAt          DateTime        @updatedAt
    addresses          Address[]
    wallets            Wallet[]
    savedCards         SavedCard[]
    supportTickets     SupportTicket[]
    carts              Cart[]
    orders             Order[]
    assignedOrders     Order[]         @relation("BaristaAssignedOrders")
    payments           Payment[]
    rewardPayments     RewardPayment[]
    notifications      Notification[]
    tipsGiven          Tip[]           @relation("CustomerTips")
    tipsReceived       Tip[]           @relation("BaristaTips")
    giftCards          GiftCard[]      @relation("RecipientGiftCards")
    purchasedGiftCards GiftCard[]      @relation("PurchasedGiftCards")
    pointTransactions  PointTransaction[]
    giftCardTransactions GiftCardTransaction[]

    @@map("users")
}

model Address {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id])

    street1 String
    street2 String?
    state   String
    city    String
    country String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Wallet {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id])

    balance Decimal

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


model SavedCard {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id])

    cardNumber String
    cvc        String
    expireDate String
    status     SavedCardStatus @default(ACTIVE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


model SupportTicket {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id])

    subject String
    message String
    status  SupportTicketStatus @default(PENDING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Category {
    id        String  @id @default(cuid())
    name      String  @unique
    isActive  Boolean @default(true)
    isDeleted Boolean @default(false)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    products  Product[]
}

model Product {
    id String @id @default(cuid())

    categoryId String
    category   Category @relation(fields: [categoryId], references: [id])

    name             String @unique
    slug             String @unique
    shortDescription String
    description      String
    basePrice        Decimal
    image            String[]
    coin             Int
    customOption     Boolean  @default(false)
    isDeleted        Boolean  @default(false)

    // Nutritional & Sensory Attributes for AI Recommendations
    caffeineMg       Int?             @default(0)
    sweetnessLevel   Int?             @default(3)
    bitternessLevel  Int?             @default(3)
    strengthLevel    Int?             @default(3)
    temperatureType  TemperatureType  @default(HOT)
    flavorProfile    String[]         @default([])
    isAvailable      Boolean          @default(true)

    createdAt                 DateTime                  @default(now())
    updatedAt                 DateTime                  @updatedAt
    productSizes              ProductSize[]
    productMilks              ProductMilk[]
    productExtras             ProductExtra[]
    cartItems                 CartItem[]
    orderItems                OrderItem[]
    coinProducts              CoinProduct[]
    productRecipes            ProductRecipe[]
    moodRecommendationItems   MoodRecommendationItem[]
}



model ProductSize {
    id String @id @default(cuid())

    productId String
    product   Product @relation(fields: [productId], references: [id])

    name            String
    oz              String
    priceAdjustment Decimal
    adjustmentType  AdjustmentType

    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
    cartItems  CartItem[]
    orderItems OrderItem[]
}

model ProductMilk {
    id String @id @default(cuid())

    productId String
    product   Product @relation(fields: [productId], references: [id])

    name            String
    priceAdjustment Decimal
    adjustmentType  AdjustmentType

    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
    cartItems  CartItem[]
    orderItems OrderItem[]
}

model ProductExtra {
    id String @id @default(cuid())

    productId String
    product   Product @relation(fields: [productId], references: [id])

    name  String
    price Decimal

    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    cartItemExtras  CartItemExtra[]
    orderItemExtras OrderItemExtra[]
}

model CoinProduct {
    id        String  @id @default(cuid())
    name      String
    productId String
    product   Product @relation(fields: [productId], references: [id])

    needPoint Int
    isDeleted Boolean @default(false)

    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
    cartItems  CartItem[]
    orderItems OrderItem[]
}

model Cart {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id])

    subTotal      Decimal?
    discount      Decimal?
    taxAmount     Decimal?
    serviceCharge Decimal?
    deliveryFee   Decimal?
    total         Decimal?

    totalCoin Int?

    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    cartItems CartItem[]
}

model CartItem {
    id     String @id @default(cuid())
    cartId String
    cart   Cart   @relation(fields: [cartId], references: [id])

    productId String?
    product   Product? @relation(fields: [productId], references: [id])

    coinProductId String?
    coinProduct   CoinProduct? @relation(fields: [coinProductId], references: [id])

    isCoinProduct Boolean  @default(false)
    quantity      Int
    basePrice     Decimal?

    selectedSizeId String?
    selectedSize   ProductSize? @relation(fields: [selectedSizeId], references: [id])
    selectedMildId String?
    selectedMild   ProductMilk? @relation(fields: [selectedMildId], references: [id])

    totalPrice Decimal?
    totalCoin  Decimal?

    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    cartItemExtras CartItemExtra[]
}

model CartItemExtra {
    id String @id @default(cuid())

    cartItemId String
    cartItem   CartItem @relation(fields: [cartItemId], references: [id])

    productExtraId String
    productExtra   ProductExtra @relation(fields: [productExtraId], references: [id])

    price Decimal

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


model Order {
    id          String @id @default(cuid())
    orderNumber String @unique

    userId String
    user   User   @relation(fields: [userId], references: [id])

    status        OrderStatus   @default(PENDING)
    paymentStatus PaymentStatus @default(PENDING)

    subTotal      Decimal?
    discount      Decimal?
    taxAmount     Decimal?
    deliveryFee   Decimal?
    serviceCharge Decimal?
    paymentMethod PaymentMethod
    payType       PayType?
    earnedCoin    Int?
    usedCoin      Int?
    total         Decimal?
    note          String?

    tipAmount         Decimal?             @default(0)
    tip               Tip?
    giftCardAmount    Decimal?             @default(0)

    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
    orderItems OrderItem[]
    payments   Payment[]
    rewardPayments RewardPayment[]
    shippingAddress ShippingAddress?

    // Barista Assignment & Automation Relations
    assignedBaristaId String?
    assignedBarista   User?                @relation("BaristaAssignedOrders", fields: [assignedBaristaId], references: [id])
    assignedAt        DateTime?
    preparedAt        DateTime?
    invoice           Invoice?
    automationLogs    OrderAutomationLog[]
    stockMovements    StockMovement[]
    giftCardTransactions GiftCardTransaction[]
    pointTransactions    PointTransaction[]
}

model Tip {
    id        String   @id @default(cuid())
    orderId   String   @unique
    order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
    userId    String
    user      User     @relation("CustomerTips", fields: [userId], references: [id])
    baristaId String?
    barista   User?    @relation("BaristaTips", fields: [baristaId], references: [id])
    amount    Decimal
    message   String?
    payType   PayType? @default(CARD)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("tips")
}

model ShippingAddress {
    id String @id @default(cuid())

    orderId String @unique
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    fullName   String?
    street1    String
    state      String?
    city       String
    country    String
    postalCode String?
    phone      String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model OrderItem {
    id String @id @default(cuid())

    orderId String
    order   Order  @relation(fields: [orderId], references: [id])

    productId String?
    product   Product? @relation(fields: [productId], references: [id])

    coinProductId String?
    coinProduct   CoinProduct? @relation(fields: [coinProductId], references: [id])

    isCoinProduct Boolean  @default(false)
    quantity      Int?
    basePrice     Decimal?

    selectedSizeId String?
    selectedSize   ProductSize? @relation(fields: [selectedSizeId], references: [id])

    selectedMilkId String?
    selectedMilk   ProductMilk? @relation(fields: [selectedMilkId], references: [id])

    totalPrice Decimal?
    totalCoin  Int

    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    orderItemExtras OrderItemExtra[]
}

model OrderItemExtra {
    id String @id @default(cuid())

    orderItemId String
    orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

    productExtraId String
    productExtra   ProductExtra @relation(fields: [productExtraId], references: [id])

    price Decimal

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Payment {
    id String @id @default(cuid())

    orderId String
    order   Order  @relation(fields: [orderId], references: [id])

    userId String
    user   User   @relation(fields: [userId], references: [id])

    paymentMethod          PayType       @default(CARD)
    status                 PaymentStatus @default(PENDING)
    amount                 Decimal
    currency               String
    transactionId          String        @unique
    gatewayPaymentId       String?
    gateWayPaymentResponse String?
    paidAt                 DateTime      @default(now())
    failureReson           String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
model RewardPayment {
    id String @id @default(cuid())

    orderId String
    order   Order  @relation(fields: [orderId], references: [id])

    userId String
    user   User   @relation(fields: [userId], references: [id])

    transactionId          String        @unique
    status                 PaymentStatus @default(PENDING)
    coin                   Int
    total                  Decimal?
    paidAt                 DateTime      @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}



model Tax{
    id String @id @default(cuid())
    title String
    description String?
    amount Decimal
    type TaxType
    status TaxStatus @default(ACTIVE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model DeliveryFee {
    id String @id @default(cuid())

    title String
    description String?
    amount Decimal
    status DeliveryFeeStatus @default(ACTIVE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ServiceCharge {
    id String @id @default(cuid())

    title String
    description String?
    amount Decimal
    status ServiceChargeStatus @default(ACTIVE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Notification {
    id        String   @id @default(cuid())
    userId    String?
    user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
    title     String
    message   String
    type      String   @default("ORDER")
    orderId   String?
    isRead    Boolean  @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("notifications")
}

model Ingredient {
    id             String   @id @default(cuid())
    name           String   @unique
    unit           String   // e.g. "ml", "g", "shot", "piece"
    currentStock   Decimal  @default(0)
    reservedStock  Decimal  @default(0)
    minStockLevel  Decimal  @default(0)
    isAvailable    Boolean  @default(true)

    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    recipes        ProductRecipe[]
    stockMovements StockMovement[]

    @@map("ingredients")
}

model ProductRecipe {
    id           String     @id @default(cuid())
    productId    String
    product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
    ingredientId String
    ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
    quantity     Decimal
    unit         String

    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    @@unique([productId, ingredientId])
    @@map("product_recipes")
}

model StockMovement {
    id           String            @id @default(cuid())
    ingredientId String
    ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
    orderId      String?
    order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
    quantity     Decimal
    type         StockMovementType
    reason       String?

    createdAt    DateTime          @default(now())

    @@map("stock_movements")
}

model Invoice {
    id            String        @id @default(cuid())
    orderId       String        @unique
    order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
    invoiceNumber String        @unique
    subTotal      Decimal
    taxAmount     Decimal       @default(0)
    discount      Decimal       @default(0)
    deliveryFee   Decimal       @default(0)
    serviceCharge Decimal       @default(0)
    total         Decimal
    status        InvoiceStatus @default(ISSUED)
    issuedAt      DateTime      @default(now())
    pdfUrl        String?

    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    @@map("invoices")
}

model MoodRecommendation {
    id          String                   @id @default(cuid())
    userId      String?
    mood        String
    rawInput    String?
    preferences Json?
    createdAt   DateTime                 @default(now())

    items       MoodRecommendationItem[]

    @@map("mood_recommendations")
}

model MoodRecommendationItem {
    id               String             @id @default(cuid())
    recommendationId String
    recommendation   MoodRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
    productId        String
    product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
    score            Float
    reason           String
    rank             Int

    createdAt        DateTime           @default(now())

    @@map("mood_recommendation_items")
}

model OrderAutomationLog {
    id          String           @id @default(cuid())
    orderId     String
    order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
    jobType     String
    status      AutomationStatus @default(PENDING)
    step        String
    attempts    Int              @default(0)
    error       String?
    metadata    Json?
    startedAt   DateTime         @default(now())
    completedAt DateTime?

    @@map("order_automation_logs")
}

model GiftCard {
    id             String         @id @default(cuid())
    code           String         @unique
    nickname       String         @default("Morning Ritual Card")
    designIndex    Int            @default(0)
    initialAmount  Decimal
    currentBalance Decimal
    status         GiftCardStatus @default(ACTIVE)
    isActive       Boolean        @default(true)

    recipientName  String
    recipientEmail String
    personalMessage String?

    purchaserId    String?
    purchaser      User?          @relation("PurchasedGiftCards", fields: [purchaserId], references: [id])

    userId         String?
    user           User?          @relation("RecipientGiftCards", fields: [userId], references: [id])

    isClaimed      Boolean        @default(false)
    claimedAt      DateTime?

    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt

    transactions   GiftCardTransaction[]

    @@map("gift_cards")
}

model GiftCardTransaction {
    id          String         @id @default(cuid())
    giftCardId  String?
    giftCard    GiftCard?      @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
    userId      String
    user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    orderId     String?
    order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
    amount      Decimal
    type        GiftCardTxType
    title       String
    location    String?
    createdAt   DateTime       @default(now())

    @@map("gift_card_transactions")
}

model PointTransaction {
    id          String      @id @default(cuid())
    userId      String
    user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    orderId     String?
    order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
    staffId     String?
    points      Int
    type        PointTxType
    reason      String?
    createdAt   DateTime    @default(now())

    @@map("point_transactions")
}



